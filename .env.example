# ===========================================================================
# Intelligent Driver Monitoring & Fleet Safety Management System
# Production & Environment Configuration Template
# ===========================================================================

# Application Environment: 'development', 'production', 'test'
ENVIRONMENT=development

# Database Connection URL
# SQLite Development: sqlite:///data/drivers.db
# PostgreSQL Production: postgresql+psycopg://postgres:your_password@localhost:5432/fleet_safety_db
DATABASE_URL=sqlite:///data/drivers.db

# Owner Authentication JWT Secret (REQUIRED in production - generate a strong random 256-bit key)
JWT_SECRET=replace-with-a-strong-random-secret-key-for-production

# JWT Expiration in minutes (Default: 1440 = 24 hours)
JWT_EXPIRE_MINUTES=1440

# Cookie Security (Set to true in HTTPS production deployments)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Web Application URL
FRONTEND_URL=http://localhost:5173

# WebSocket Monitoring Origin
WS_ORIGIN=ws://127.0.0.1:8000

# Camera & Biometrics Configuration
DMS_CAMERA_INDEX=0
DMS_MODEL_NAME=buffalo_l
DMS_DETECTION_CONFIDENCE=0.5
DMS_RECOGNITION_THRESHOLD=0.45
DMS_MONITORING_FPS=15
